<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>
  <body>

    <% if(user){ %>
      <h1>Welcome to the app, <%= user.username %>!</h1>
      <p>
        <a href="/auth/sign-out">Log out</a>
        <a href="/protected">PROTECTED ROUTE EXAMPLE</a>
      </p>
    <% }else{ %>
      <h1>Welcome to the app!</h1>
      <a href="/auth/sign-up">Register</a>
      <a href="/auth/sign-in">Login</a>
    <%}%>


  </body>
</html>